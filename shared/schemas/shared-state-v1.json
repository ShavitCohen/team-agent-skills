  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Team agent skills shared state, version 1",
  "description": "Identity, run-registry, lease, and watcher-state records. A document whose schema_version is greater than 1 is rejected rather than interpreted, and is preserved untouched.",
  "oneOf": [
