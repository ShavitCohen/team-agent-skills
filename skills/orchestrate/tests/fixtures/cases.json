{
  "schema_version": 1,
  "cases": [
    {
      "id": "locking-free-lock-is-acquired",
      "family": "locking",
      "description": "A free target lock is taken and the run is registered.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/run_lock.sh",
        "acquire",
        "pr-fix",
        "own-er-re-po-issue1"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_matches": [
          "\"result\":\"acquired\"",
          "\"run_id\":"
        ],
        "path_exists": [
          "{{TMP}}/state/runs/pr-fix/own-er-re-po-issue1.json"
        ]
      }
    },
    {
      "id": "locking-live-lock-blocks-a-second-run",
      "family": "locking",
      "description": "A lock held by a live run stops a second run on the same target instead of producing two writers.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "fs": {
          "files": {
            "{{TMP}}/state/locks/pr-fix/own-er-re-po-issue1.lock/lease.json": "{\"schema_version\":1,\"kind\":\"lease\",\"skill\":\"pr-fix\",\"key\":\"own-er-re-po-issue1\",\"run_id\":\"already-running\",\"pid\":null,\"acquired_at\":{{NOW}},\"heartbeat\":{{NOW}},\"ttl\":900}"
          }
        }
      },
      "invoke": [
        "{{PKG}}/scripts/run_lock.sh",
        "acquire",
        "pr-fix",
        "own-er-re-po-issue1"
      ],
      "expect": {
        "exit_code": 3,
        "stdout_matches": [
          "\"result\":\"held\"",
          "already-running"
        ]
      }
    },
    {
      "id": "locking-stale-lease-is-taken-over-not-deleted",
      "family": "locking",
      "description": "A lease past its time-to-live is taken over; the previous run's registry entry is reused rather than discarded.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "fs": {
          "files": {
            "{{TMP}}/state/locks/pr-fix/own-er-re-po-issue1.lock/lease.json": "{\"schema_version\":1,\"kind\":\"lease\",\"skill\":\"pr-fix\",\"key\":\"own-er-re-po-issue1\",\"run_id\":\"dead-run\",\"pid\":null,\"acquired_at\":{{PAST}},\"heartbeat\":{{PAST}},\"ttl\":900}",
            "{{TMP}}/state/runs/pr-fix/own-er-re-po-issue1.json": "{\"schema_version\":1,\"kind\":\"run\",\"skill\":\"pr-fix\",\"key\":\"own-er-re-po-issue1\",\"run_id\":\"dead-run\",\"target\":{\"owner\":\"own-er\",\"repository\":\"re-po\",\"kind\":\"issue\",\"number\":1},\"worktree\":\"{{TMP}}/state/worktrees/pr-fix/own-er-re-po-issue1\",\"clone\":null,\"mode\":\"editable\",\"branch\":\"feat/1\",\"head_sha\":null,\"base_sha\":null,\"started_at\":{{PAST}},\"heartbeat\":{{PAST}},\"ttl\":900,\"pid\":null,\"state\":\"active\",\"artifact_globs\":[],\"meta\":{}}"
          }
        }
      },
      "invoke": [
        "bash",
        "-c",
        "{{PKG}}/scripts/run_lock.sh acquire pr-fix own-er-re-po-issue1 && jq -r '.worktree' {{TMP}}/state/runs/pr-fix/own-er-re-po-issue1.json"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_matches": [
          "\"result\":\"takeover\"",
          "worktrees/pr-fix/own-er-re-po-issue1"
        ]
      }
    },
    {
      "id": "locking-registry-records-the-checkout-mode",
      "family": "state",
      "description": "Checkout mode travels into the registry so safe-removal rules can be applied later.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        }
      },
      "invoke": [
        "bash",
        "-c",
        "{{PKG}}/scripts/run_lock.sh acquire pr-fix own-er-re-po-issue2 --meta '{\"mode\":\"disposable-verification\"}' >/dev/null && jq -r '.mode' {{TMP}}/state/runs/pr-fix/own-er-re-po-issue2.json"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_matches": [
          "^disposable-verification$"
        ]
      }
    },
    {
      "id": "state-refuses-an-unknown-newer-schema-version",
      "family": "state",
      "description": "A persisted document from a newer schema is refused rather than guessed at, and is left untouched.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "fs": {
          "files": {
            "{{TMP}}/state/runs/pr-fix/own-er-re-po-issue3.json": "{\"schema_version\":2,\"kind\":\"run\",\"skill\":\"pr-fix\",\"key\":\"own-er-re-po-issue3\",\"run_id\":\"future\"}"
          }
        }
      },
      "invoke": [
        "{{PKG}}/scripts/run_lock.sh",
        "remove",
        "pr-fix",
        "own-er-re-po-issue3",
        "--run-id",
        "future"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_matches": [
          "schema_version 2",
          "refusing to interpret"
        ],
        "path_exists": [
          "{{TMP}}/state/runs/pr-fix/own-er-re-po-issue3.json"
        ]
      }
    },
    {
      "id": "paths-worktree-path-is-derived-from-skill-and-target",
      "family": "paths",
      "description": "Two runs on different targets, and two skills on one target, can never share a worktree path.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/run_lock.sh",
        "path",
        "pr-fix",
        "own-er",
        "re-po",
        "issue",
        "12"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_matches": [
          "worktrees/pr-fix/own-er-re-po-issue12$"
        ]
      }
    },
    {
      "id": "paths-rejects-a-parent-reference",
      "family": "paths",
      "description": "A parent reference in a target component is rejected instead of escaping the state layout.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/run_lock.sh",
        "path",
        "pr-fix",
        "..",
        "re-po",
        "issue",
        "12"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_matches": [
          "invalid owner"
        ]
      }
    },
    {
      "id": "paths-rejects-a-separator-in-a-lock-key",
      "family": "paths",
      "description": "A path separator in a lock key is rejected.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/run_lock.sh",
        "acquire",
        "pr-fix",
        "own-er/re-po"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_matches": [
          "path separator"
        ]
      }
    },
    {
      "id": "paths-refuses-a-symlinked-state-root",
      "family": "paths",
      "description": "A symlinked state root is refused rather than followed.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/link"
        },
        "fs": {
          "dirs": [
            "{{TMP}}/real"
          ],
          "symlinks": {
            "{{TMP}}/link": "{{TMP}}/real"
          }
        }
      },
      "invoke": [
        "{{PKG}}/scripts/run_lock.sh",
        "status",
        "pr-fix",
        "own-er-re-po-issue1"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_matches": [
          "symlinked state path"
        ]
      }
    },
    {
      "id": "identity-probes-logins-without-asking-the-user",
      "family": "identity",
      "description": "Identity selection probes the authenticated accounts and never interrupts the workflow to ask which to use.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "gh": {
          "auth status": "github.com\n  Logged in to github.com account first-login (keyring)\n  Logged in to github.com account second-login (keyring)",
          "auth token --user": "token-$MOCK_LAST_ARG",
          "api user": "$GH_TOKEN_SUFFIX",
          "api repos/": "{\"archived\":false,\"locked\":false,\"permissions\":{\"push\":true,\"pull\":true}}"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/gh_identity.sh",
        "select",
        "--need",
        "write",
        "own-er/re-po#5"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_matches": [
          "\"login\":\"first-login\"",
          "capability probing"
        ],
        "path_exists": [
          "{{TMP}}/state/config/identities.json"
        ]
      }
    },
    {
      "id": "identity-does-not-save-a-login-that-failed-its-probe",
      "family": "identity",
      "description": "When no authenticated account satisfies the capability, every attempted login is reported and nothing is saved.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "gh": {
          "auth status": "github.com\n  Logged in to github.com account first-login (keyring)\n  Logged in to github.com account second-login (keyring)",
          "auth token --user": "token-$MOCK_LAST_ARG",
          "api user": "$GH_TOKEN_SUFFIX",
          "api repos/": "{\"archived\":false,\"locked\":false,\"permissions\":{\"push\":false,\"pull\":true}}"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/gh_identity.sh",
        "select",
        "--need",
        "write",
        "own-er/re-po#5"
      ],
      "expect": {
        "exit_code": 1,
        "stderr_matches": [
          "no authenticated account satisfies",
          "first-login",
          "second-login"
        ],
        "path_absent": [
          "{{TMP}}/state/config/identities.json"
        ]
      }
    },
    {
      "id": "identity-accepts-hyphenated-owner-and-repository-names",
      "family": "identity",
      "description": "Hyphenated owners and repository names parse correctly and are not split on the hyphen.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "gh": {
          "auth status": "github.com"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/gh_identity.sh",
        "get",
        "own-er/re-po#42"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_matches": [
          "\"target\":\"own-er/re-po#42\""
        ]
      }
    },
    {
      "id": "identity-refuses-a-group-writable-configuration-path",
      "family": "identity",
      "description": "Saved identities never live in a directory another account can write.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "fs": {
          "dirs": [
            "{{TMP}}/state/config"
          ],
          "modes": {
            "{{TMP}}/state/config": "770"
          }
        },
        "gh": {
          "auth status": "github.com"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/gh_identity.sh",
        "get",
        "own-er/re-po#42"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_matches": [
          "group- or world-writable"
        ]
      }
    },
    {
      "id": "push-refuses-a-non-canonical-remote-url",
      "family": "push",
      "description": "Only the canonical https URL for the named repository is accepted; another host cannot receive the token.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "gh": {
          "auth status": "github.com"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/gh_identity.sh",
        "git-push",
        "own-er/re-po#5",
        "--repo",
        "own-er/re-po",
        "--remote-url",
        "https://example.invalid/own-er/re-po.git",
        "--source",
        "HEAD",
        "--dest",
        "refs/heads/feat"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_matches": [
          "canonical https URL"
        ]
      }
    },
    {
      "id": "push-refuses-a-destination-outside-branch-refs",
      "family": "push",
      "description": "A destination outside refs/heads/ is refused, so a tag or arbitrary ref cannot be written.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "gh": {
          "auth status": "github.com"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/gh_identity.sh",
        "git-push",
        "own-er/re-po#5",
        "--repo",
        "own-er/re-po",
        "--remote-url",
        "https://github.com/own-er/re-po.git",
        "--source",
        "HEAD",
        "--dest",
        "refs/tags/v1"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_matches": [
          "refs/heads/"
        ]
      }
    },
    {
      "id": "push-refuses-multiple-destinations",
      "family": "push",
      "description": "One push writes exactly one branch ref.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "gh": {
          "auth status": "github.com"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/gh_identity.sh",
        "git-push",
        "own-er/re-po#5",
        "--repo",
        "own-er/re-po",
        "--remote-url",
        "https://github.com/own-er/re-po.git",
        "--source",
        "HEAD",
        "--dest",
        "refs/heads/a refs/heads/b"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_matches": [
          "exactly one branch ref"
        ]
      }
    },
    {
      "id": "push-refuses-a-short-force-with-lease-sha",
      "family": "push",
      "description": "A lease must name the exact previously observed full SHA, so a partial value cannot weaken it.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "gh": {
          "auth status": "github.com"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/gh_identity.sh",
        "git-push",
        "own-er/re-po#5",
        "--repo",
        "own-er/re-po",
        "--remote-url",
        "https://github.com/own-er/re-po.git",
        "--source",
        "HEAD",
        "--dest",
        "refs/heads/feat",
        "--force-with-lease",
        "abc123"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_matches": [
          "40-character SHA"
        ]
      }
    },
    {
      "id": "push-refuses-malicious-url-rewrites",
      "family": "push",
      "description": "Configured url insteadOf rewrites could redirect the credentialed push, so the push fails closed.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state",
          "HOME": "{{TMP}}/evil-home"
        },
        "fs": {
          "files": {
            "{{TMP}}/evil-home/.gitconfig": "[url \"https://example.invalid/\"]\n\tinsteadOf = https://github.com/\n"
          }
        },
        "gh": {
          "auth status": "github.com"
        }
      },
      "invoke": [
        "{{PKG}}/scripts/gh_identity.sh",
        "git-push",
        "own-er/re-po#5",
        "--repo",
        "own-er/re-po",
        "--remote-url",
        "https://github.com/own-er/re-po.git",
        "--source",
        "HEAD",
        "--dest",
        "refs/heads/feat"
      ],
      "expect": {
        "exit_code": 2,
        "stderr_matches": [
          "insteadOf"
        ]
      }
    },
    {
      "id": "state-lane-plan-defaults-to-this-runtime",
      "family": "state",
      "description": "With no profile installed, every stage runs on this runtime — inline where the user is, sub-agents for the rest — and the plan says so rather than naming a runtime the package does not know.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "gh": {}
      },
      "invoke": [
        "{{PKG}}/scripts/lane_profile.sh",
        "resolve",
        "--runtime",
        "Fixture Runtime 1.0"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_matches": [
          "\"source\":\"default\"",
          "\"create-clarity\":\\{\"lane\":\"inline\"",
          "\"pr-review\":\\{\"lane\":\"agent\""
        ],
        "stdout_not_matches": [
          "\"model\":\"[a-z]"
        ]
      }
    },
    {
      "id": "state-lane-profile-matches-a-runtime-by-label",
      "family": "state",
      "description": "A runtime entry is chosen by case-insensitive substring of the label this runtime exposes, and its cli lane and model survive resolution.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "gh": {},
        "fs": {
          "files": {
            "{{TMP}}/state/config/orchestrate.json": "{\n  \"schema_version\": 1,\n  \"runtimes\": {\n    \"mine\": {\n      \"match\": [\n        \"fixture runtime\"\n      ],\n      \"stages\": {\n        \"pr-review\": {\n          \"lane\": \"cli:OTHER\",\n          \"model\": null,\n          \"effort\": null\n        },\n        \"pr-fix\": {\n          \"lane\": \"agent\",\n          \"model\": \"a-model\",\n          \"effort\": \"high\"\n        }\n      }\n    },\n    \"default\": {\n      \"stages\": {}\n    }\n  },\n  \"cli\": {\n    \"OTHER\": {\n      \"command\": [\n        \"a-runtime-that-does-not-exist\",\n        \"--model\",\n        \"{model}\",\n        \"--cwd\",\n        \"{cwd}\"\n      ],\n      \"runtime_label\": \"Other Fixture Runtime\",\n      \"github_login\": null,\n      \"skills_roots\": [\n        \"{home}/other-skills\"\n      ]\n    }\n  }\n}"
          }
        }
      },
      "invoke": [
        "{{PKG}}/scripts/lane_profile.sh",
        "resolve",
        "--runtime",
        "A Fixture Runtime, build 9"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_matches": [
          "\"source\":\"profile\"",
          "\"matched_runtime\":\"mine\"",
          "\"lane\":\"cli:OTHER\"",
          "\"model\":\"a-model\""
        ]
      }
    },
    {
      "id": "state-lane-profile-falls-back-to-the-default-entry",
      "family": "state",
      "description": "An unrecognized runtime takes the default entry rather than the first one that happens to be listed.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "gh": {},
        "fs": {
          "files": {
            "{{TMP}}/state/config/orchestrate.json": "{\n  \"schema_version\": 1,\n  \"runtimes\": {\n    \"mine\": {\n      \"match\": [\n        \"fixture runtime\"\n      ],\n      \"stages\": {\n        \"pr-review\": {\n          \"lane\": \"cli:OTHER\",\n          \"model\": null,\n          \"effort\": null\n        },\n        \"pr-fix\": {\n          \"lane\": \"agent\",\n          \"model\": \"a-model\",\n          \"effort\": \"high\"\n        }\n      }\n    },\n    \"default\": {\n      \"stages\": {}\n    }\n  },\n  \"cli\": {\n    \"OTHER\": {\n      \"command\": [\n        \"a-runtime-that-does-not-exist\",\n        \"--model\",\n        \"{model}\",\n        \"--cwd\",\n        \"{cwd}\"\n      ],\n      \"runtime_label\": \"Other Fixture Runtime\",\n      \"github_login\": null,\n      \"skills_roots\": [\n        \"{home}/other-skills\"\n      ]\n    }\n  }\n}"
          }
        }
      },
      "invoke": [
        "{{PKG}}/scripts/lane_profile.sh",
        "resolve",
        "--runtime",
        "Something Else Entirely"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_matches": [
          "\"matched_runtime\":\"default\"",
          "\"pr-review\":\\{\"lane\":\"agent\""
        ]
      }
    },
    {
      "id": "state-lane-profile-drops-an-unfilled-placeholder-with-its-flag",
      "family": "state",
      "description": "A stage with no model must not hand the other runtime a bare --model, so the placeholder and the flag before it are dropped together. --check-commands reports the missing executable instead of running it.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "gh": {},
        "fs": {
          "files": {
            "{{TMP}}/state/config/orchestrate.json": "{\n  \"schema_version\": 1,\n  \"runtimes\": {\n    \"mine\": {\n      \"match\": [\n        \"fixture runtime\"\n      ],\n      \"stages\": {\n        \"pr-review\": {\n          \"lane\": \"cli:OTHER\",\n          \"model\": null,\n          \"effort\": null\n        },\n        \"pr-fix\": {\n          \"lane\": \"agent\",\n          \"model\": \"a-model\",\n          \"effort\": \"high\"\n        }\n      }\n    },\n    \"default\": {\n      \"stages\": {}\n    }\n  },\n  \"cli\": {\n    \"OTHER\": {\n      \"command\": [\n        \"a-runtime-that-does-not-exist\",\n        \"--model\",\n        \"{model}\",\n        \"--cwd\",\n        \"{cwd}\"\n      ],\n      \"runtime_label\": \"Other Fixture Runtime\",\n      \"github_login\": null,\n      \"skills_roots\": [\n        \"{home}/other-skills\"\n      ]\n    }\n  }\n}"
          }
        }
      },
      "invoke": [
        "{{PKG}}/scripts/lane_profile.sh",
        "resolve",
        "--runtime",
        "Fixture Runtime",
        "--cwd",
        "{home}/work",
        "--check-commands"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_matches": [
          "\"command\":\\[\"a-runtime-that-does-not-exist\",\"--cwd\",\"[^\"]*/work\"\\]",
          "\"executable_present\":false"
        ]
      }
    },
    {
      "id": "state-lane-profile-refuses-a-newer-schema",
      "family": "state",
      "description": "A profile written for a later version is refused, not guessed past.",
      "given": {
        "env": {
          "TEAM_SKILLS_STATE_DIR": "{{TMP}}/state"
        },
        "gh": {},
        "fs": {
          "files": {
            "{{TMP}}/profile.json": "{\n  \"schema_version\": 99,\n  \"runtimes\": {\n    \"mine\": {\n      \"match\": [\n        \"fixture runtime\"\n      ],\n      \"stages\": {\n        \"pr-review\": {\n          \"lane\": \"cli:OTHER\",\n          \"model\": null,\n          \"effort\": null\n        },\n        \"pr-fix\": {\n          \"lane\": \"agent\",\n          \"model\": \"a-model\",\n          \"effort\": \"high\"\n        }\n      }\n    },\n    \"default\": {\n      \"stages\": {}\n    }\n  },\n  \"cli\": {\n    \"OTHER\": {\n      \"command\": [\n        \"a-runtime-that-does-not-exist\",\n        \"--model\",\n        \"{model}\",\n        \"--cwd\",\n        \"{cwd}\"\n      ],\n      \"runtime_label\": \"Other Fixture Runtime\",\n      \"github_login\": null,\n      \"skills_roots\": [\n        \"{home}/other-skills\"\n      ]\n    }\n  }\n}"
          }
        }
      },
      "invoke": [
        "{{PKG}}/scripts/lane_profile.sh",
        "validate",
        "--profile",
        "{{TMP}}/profile.json"
